@model IEnumerable<mvc2025RoutingAssignment.Models.ViewModels.TagsViewModel>

@{
    ViewData["Title"] = "Tags (Index)";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().TagName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().PostCount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TagName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PostCount)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TagID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.TagID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.TagID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

